# Dockerfile_DGX_Spark — Isaac Sim + Replicator for the regolith pipeline
#
# IMPORTANT — we run NVIDIA's prebuilt Isaac Sim image directly; we do NOT build our
# own image. Pull this tag and invoke it with scripts/run_isaac.sh.
#
#   Image:    nvcr.io/nvidia/isaac-sim:6.0.0
#   Version:  6.0.0-rc.59+release.41464
#   Platform: multi-arch manifest — pulls linux/arm64 automatically on the DGX Spark
#             (aarch64/GB10), linux/amd64 on x86 dev machines.
#   Access:   public — no NGC login required.
#   Size:     17.6 GB on disk; allow ~7 min for first pull.
#
# Do NOT change the pinned tag without re-running the smoke test
# (see setup-notes.md ## Session 2 and replicator/_smoke_render.py).
#
# ── Headless invocation ────────────────────────────────────────────────────────
#
#   /isaac-sim/python.sh <script.py>
#
#   This wrapper sets PYTHONPATH, LD_LIBRARY_PATH, and all Omniverse/CarB env vars
#   before launching the embedded Python interpreter. Always use it — do NOT call
#   python3 directly or Replicator extensions will not initialise.
#
#   Full launch command (handled by scripts/run_isaac.sh):
#
#     docker run --entrypoint bash --gpus all --network=host --rm \
#       -e ACCEPT_EULA=Y -e PRIVACY_CONSENT=Y \
#       -v <host-script>:/workspace/<script>:ro \
#       -v <host-out-dir>:/workspace/out:rw \
#       nvcr.io/nvidia/isaac-sim:6.0.0 \
#       -lc "/isaac-sim/python.sh /workspace/<script>"
#
# ── Load-bearing gotchas (validated 2026-06-26 on DGX Spark / GB10 / sm_121) ──
#
#   1. DO NOT bind-mount /isaac-sim/.cache from the host.
#      Container runs as uid 1234 (user "isaac-sim"). A host-owned bind-mount at
#      that exact path triggers PermissionError in wp.init() (NVIDIA Warp), aborting
#      extension startup and cascading into misleading downstream errors:
#        - "No writer 'BasicWriter'"
#        - "OgnRefTimeGate TypeError"
#        - rep.orchestrator becomes NoneType
#      For shader-cache persistence (eliminates the ~150 s first-frame penalty on
#      reruns), mount a SEPARATE host dir that is chmod 777 and point the container
#      at it — do not reuse /isaac-sim/.cache.
#
#   2. Use poll-for-files drain, not bare wait_until_complete().
#      The first RTX frame on the DGX Spark (GB10/sm_121) takes ~150 s.
#      rep.orchestrator.wait_until_complete()'s internal drain timeout fires before
#      the frame lands, leaving the output directory empty. After
#      rep.orchestrator.step(), pump simulation_app.update() in a loop and poll the
#      output directory for PNGs (budget: 180 s). Call wait_until_complete() only
#      after at least 2 PNG files are confirmed present.
#      See replicator/_smoke_render.py for the reference implementation.
#
# ── Hardware context ───────────────────────────────────────────────────────────
#
#   NVIDIA DGX Spark (GB10 Grace Blackwell, aarch64, CUDA 13, sm_121,
#   128 GB unified memory — nvidia-smi reports VRAM as N/A, which is expected).
#   PhysX-GPU and RTX work out of the box inside this container on sm_121 —
#   no source builds, no TORCH_CUDA_ARCH_LIST, no X11 headers needed.
#
# See setup-notes.md ## Session 2 and docs/dgx-spark-regolith-manual.md § 7.

FROM nvcr.io/nvidia/isaac-sim:6.0.0
